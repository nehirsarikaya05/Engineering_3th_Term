digraph "top_module" {
label="top_module";
rankdir="LR";
remincross=true;
n2 [ shape=octagon, label="data_1", color="black", fontcolor="black" ];
n3 [ shape=octagon, label="data_2", color="black", fontcolor="black" ];
n4 [ shape=octagon, label="evidence", color="black", fontcolor="black" ];
n5 [ shape=octagon, label="result", color="black", fontcolor="black" ];
c9 [ shape=record, label="{{<p6> A|<p7> B}|$3\n$eq|{<p8> Y}}",  ];
c10 [ shape=record, label="{{<p6> A}|$2\n$not|{<p8> Y}}",  ];
c11 [ shape=record, label="{{<p6> A|<p7> B}|$1\n$sub|{<p8> Y}}",  ];
c10:p8:e -> c9:p7:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n2:e -> c10:p6:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n2:e -> c11:p7:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3:e -> c11:p6:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c9:p8:e -> n4:w [color="black", fontcolor="black", label=""];
c11:p8:e -> n5:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n5:e -> c9:p6:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
}
